# Temporary kill switch: set to 'true' to disable the password gate
# entirely (the whole site becomes publicly accessible). Leave unset or set
# to anything else to keep the password gate active. Remove again to revert.
PORTAL_PUBLIC=

# Site password gate
# Master password users type at /login
SITE_PASSWORD=change-me

# Server-side session token. Generate a random string for production.
# The auth cookie value equals AUTH_SECRET when a user is logged in.
AUTH_SECRET=replace-with-random-string

# Sanity (free tier). Create a project at sanity.io and paste IDs below.
# Until these are set with real values, /studio, /case-studies and /admin/upload
# will render a setup-needed notice instead of failing.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-side write token (Editor or higher). Required for case study submissions
# and photo uploads to write to Sanity from the form actions.
SANITY_WRITE_TOKEN=

# Optional: where Alchemy is notified of new case study submissions
ALCHEMY_NOTIFY_EMAIL=
